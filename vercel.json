{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/scan/[scanId]/progress/route.ts": {
      "maxDuration": 1800,
      "memory": 3009
    },
    "app/api/cron/run-schedules/route.ts": {
      "maxDuration": 1800,
      "memory": 3009
    },
    "app/api/crawl/route.ts": {
      "memory": 3009,
      "maxDuration": 800
    }
  },
  "crons": [
    {
      "path": "/api/cron/run-schedules",
      "schedule": "*/5 * * * *"
    }
  ]
}
